# Shared by both Vite panels (apps/super-admin on :4100, apps/clinic-admin on
# :4200). Copy to .env and adjust. Only public values belong in this file.

# Base URL of the DentaGrow API. Locally the API listens on the PORT defined in
# api/.env (4400). In production set this to the deployed Wasmer Edge origin,
# and add that same origin to ALLOWED_ORIGINS in the API configuration.
VITE_API_BASE_URL=http://127.0.0.1:4400

# Public Supabase client settings. Use the anon key only - the service_role key
# stays server-side. Tenant authorization is enforced by the API and RLS.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
