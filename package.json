{
  "name": "dentagrow-suite",
  "private": true,
  "version": "1.0.2",
  "workspaces": [
    "apps/*",
    "api",
    "packages/*"
  ],
  "scripts": {
    "dev:super": "vite --config apps/super-admin/vite.config.ts",
    "dev:clinic": "vite --config apps/clinic-admin/vite.config.ts",
    "dev:api": "tsx api/src/server.ts",
    "build:super": "vite build --config apps/super-admin/vite.config.ts",
    "build:clinic": "vite build --config apps/clinic-admin/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:super && npm run build:clinic"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9"
  }
}
