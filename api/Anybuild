load("//anybuild/tools:node.bzl", "node_build", "node_config", "node_serve")

config = node_config(
    schema = 1,
    commands = {
        "start": "node dist/server.js",
    },
    node_package_manager = "npm",
    node_framework = "express",
    node_server = "node",
    node_build_command = "npm run build",
    node_version = "24",
)

build = node_build(config)

node_serve(
    config,
    build,
    name = "dentagrow-api",
)