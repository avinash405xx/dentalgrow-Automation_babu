# Local port the API listens on. On Wasmer Edge the platform injects PORT=80
# (see app.yaml), so this value only applies to local development.
PORT=4400

# Supabase project. The project ref must match EXACTLY: a mistyped ref does not
# resolve (getaddrinfo ENOTFOUND) and every database-backed call returns 503.
SUPABASE_URL=https://mjtbinsmgblgwfvcdsjp.supabase.co

# Server-side only. Never ship this to a browser bundle. Must be the current
# service_role ("sb_secret_...") key for the project above.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Server-side only. Generate a fresh value per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DENTAGROW_INTERNAL_SECRET=your_dentagrow_internal_secret

# Browser origins permitted to call the API. Must match the Vite dev ports in
# apps/*/vite.config.ts (super-admin 4100, clinic-admin 4200) plus the
# deployed dashboard origins. Never use a wildcard.
ALLOWED_ORIGINS=http://localhost:4100,http://localhost:4200,http://127.0.0.1:4100,http://127.0.0.1:4200
